               <documentation>Flora-Fauna-Habitat (FFH-Richtlinie)</documentation>
            </annotation>
         </enumeration>
         <enumeration value="3000">
            <annotation>
               <documentation>Vogelschutzgebiet (EU-Vogelschutzrichtlinie)</documentation>
            </annotation>
         </enumeration>
