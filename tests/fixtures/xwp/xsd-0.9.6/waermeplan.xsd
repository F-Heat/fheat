               <element name="gehoertZuPlan" type="gml:ReferenceType">
                  <annotation>
                     <documentation>Relation der Bestandsanalyse auf den zugehörigen Plan</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Plan</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:infrastruktur</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_Waermelinie"
            substitutionGroup="xwp:WP_Linienobjekt"
            type="xwp:WP_WaermelinieType">
      <annotation>
         <documentation>Wärmeliniendichten in Megawattstunden pro Meter und Jahr in Form einer straßenabschnittbezogenen Darstellung entsprechend  WPG Anlage 2 I.2.2</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermelinieType">
      <complexContent>
         <extension base="xwp:WP_LinienobjektType">
            <sequence>
               <element minOccurs="0" name="waermeMenge" type="gml:MeasureType">
                  <annotation>
                     <documentation>Jährlicher Wärmeverbrauch oder Wärmebedarf aller Objekte innerhalb eines Leitungsabschnitts</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="waermelinienDichte" type="gml:MeasureType">
                  <annotation>
                     <documentation>Quotient aus Wärmeverbrauch/-bedarf der Objekte  innerhalb eines Leitungsabschnitts und der Länge dieses Leitungsabschnitts</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="laenge" type="gml:MeasureType">
                  <annotation>
                     <documentation>Länge des Abschnitts der Wärmelinie</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_Waermenetz"
            substitutionGroup="xwp:WP_ThermischeNetze"
            type="xwp:WP_WaermenetzType">
      <annotation>
         <documentation>Informationen zum Wärmenetz entsprechend WPG Anlage 2 I.2.8.a).</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermenetzType">
      <complexContent>
         <extension base="xwp:WP_ThermischeNetzeType">
            <sequence>
               <element name="status" type="xwp:WP_StatusType">
                  <annotation>
                     <documentation>Errichtungsstatus des Wärmenetzes</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="temperatur" type="gml:MeasureType">
                  <annotation>
                     <documentation>Temperatur (Mandatorisch bei Bestandsnetzen)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="geplanteInbetriebZeit" type="string">
                  <annotation>
                     <documentation>Jahr oder Zeitraum einer geplanten Inbetriebnahme</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eeNachEnergietraeger"
                        type="xwp:WP_EndenergieEnergietraegerPropertyType">
                  <annotation>
                     <documentation>Jährlicher Endenergieverbrauch oder Bedarf nach Energieträgern (für Status "Bestehend")</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_WaermenetzeGesamt"
            substitutionGroup="gml:AbstractObject"
            type="xwp:WP_WaermenetzeGesamtType">
      <annotation>
         <documentation>Datentyp mit Informationen zu den Wärmenetzen</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermenetzeGesamtType">
      <sequence>
         <element name="anzahlNetze" type="integer">
            <annotation>
               <documentation>Anzahl der Wärmenetze</documentation>
            </annotation>
         </element>
         <element name="trassenlaenge" type="gml:MeasureType">
            <annotation>
               <documentation>Gesamte Trassenlänge</documentation>
            </annotation>
         </element>
      </sequence>
   </complexType>
   <complexType name="WP_WaermenetzeGesamtPropertyType">
      <sequence>
         <element ref="xwp:WP_WaermenetzeGesamt"/>
      </sequence>
   </complexType>
   <element name="WP_WaermeversorgungArt"
            substitutionGroup="gml:AbstractObject"
            type="xwp:WP_WaermeversorgungArtType">
      <annotation>
         <documentation>Datentyp zur Erfassung der Endenergie über die Wärmeversorgungsart</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermeversorgungArtType">
      <sequence>
         <element name="eeWaermenetzVersorgung" type="gml:MeasureType">
            <annotation>
               <documentation>Jährliche Endenergie der leitungsgebundenen Wärme</documentation>
            </annotation>
         </element>
         <element name="eeDezentraleVersorgung" type="gml:MeasureType">
            <annotation>
               <documentation>Jährliche Endenergie der dezentralen Wärmeversorgung</documentation>
            </annotation>
         </element>
      </sequence>
   </complexType>
   <complexType name="WP_WaermeversorgungArtPropertyType">
      <sequence>
         <element ref="xwp:WP_WaermeversorgungArt"/>
      </sequence>
   </complexType>
   <element name="WP_WaermeversorgungsgebietStuetzjahr"
            substitutionGroup="xwp:WP_Waermversorgungsgebiet"
            type="xwp:WP_WaermeversorgungsgebietStuetzjahrType">
      <annotation>
         <documentation>Einteilung des beplanten Gebiets in voraussichtliche Wärmeversorgungsgebiete in den Stüztjahren entsprechend WPG Anlage 2 IV.</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermeversorgungsgebietStuetzjahrType">
      <complexContent>
         <extension base="xwp:WP_WaermversorgungsgebietType">
            <sequence>
               <element name="stuetzjahr" type="xwp:WP_StuetzjahrType">
                  <annotation>
                     <documentation>Stützjahr</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <simpleType name="WP_WaermeversorgungsgebietTypType">
      <annotation>
         <documentation>Aufzählung der Wärmeversorgungsgebiete</documentation>
      </annotation>
      <restriction base="string">
         <enumeration value="1000">
            <annotation>
               <documentation>Beplantes Teilgebiet, in dem ein Wärmenetz besteht oder geplant ist und ein erheblicher Anteil der ansässigen Letztverbraucher über das Wärmenetz versorgt werden soll.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="10001">
            <annotation>
               <documentation>Beplantes Teilgebiet, in dem Letztverbraucher, die sich in unmittelbarer Nähe zu einem bestehenden Wärmenetz befinden, mit diesem verbunden werden sollen, ohne dass hierfür der Ausbau des Wärmenetzes erforderlich würde.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="10002">
            <annotation>
               <documentation>Beplantes Teilgebiet, in dem es bislang kein Wärmenetz gibt und das durch den Neubau von Wärmeleitungen erstmals an ein bestehendes Wärmenetz angeschlossen werden soll.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="10003">
            <annotation>
               <documentation>Beplantes Teilgebiet, das an ein neues Wärmenetz angeschlossen werden soll.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2000">
            <annotation>
               <documentation>Beplantes Teilgebiet, in dem ein Wasserstoffnetz besteht oder geplant ist und ein erheblicher Anteil der ansässigen Letztverbraucher über das Wasserstoffnetz zum Zweck der Wärmeerzeugung versorgt werden soll.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="3000">
            <annotation>
               <documentation>Beplantes Teilgebiet, das überwiegend nicht über ein Wärme- oder ein Gasnetz versorgt werden soll.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="4000">
            <annotation>
               <documentation>Beplantes Teilgebiet, das nicht in ein voraussichtliches Wärmeversorgungsgebiet eingeteilt werden soll, weil die für eine Einteilung erforderlichen Umstände noch nicht ausreichend bekannt sind oder weil ein erheblicher Anteil der ansässigen Letztverbraucher auf andere Art mit Wärme versorgt werden soll.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="40001">
            <annotation>
               <documentation>Prüfgebiet Wärmenetz</documentation>
            </annotation>
         </enumeration>
         <enumeration value="40002">
            <annotation>
               <documentation>Prüfgebiet Wasserstoffnetzgebiet</documentation>
            </annotation>
         </enumeration>
         <enumeration value="40003">
            <annotation>
               <documentation>Prüfgebiet für die leitungsgebundene Versorgung mit grünem Methan</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <element name="WP_WaermeversorgungsgebietUmsetzung"
            substitutionGroup="xwp:WP_Waermversorgungsgebiet"
            type="xwp:WP_WaermeversorgungsgebietUmsetzungType">
      <annotation>
         <documentation>Einteilung des beplanten Gebiets in voraussichtliche Wärmeversorgungsgebiete zu einem frei wählbaren Zeitpunkt, passend zu Ausbaumaßnahmen der Wärmeversorgung</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermeversorgungsgebietUmsetzungType">
      <complexContent>
         <extension base="xwp:WP_WaermversorgungsgebietType">
            <sequence>
               <element name="jahr" type="string">
                  <annotation>
                     <documentation>Jahr, auf das sich die Einteilgung bezieht</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_WaermeversorgungsgebietZieljahr"
            substitutionGroup="xwp:WP_Waermversorgungsgebiet"
            type="xwp:WP_WaermeversorgungsgebietZieljahrType">
      <annotation>
         <documentation>Einteilung des beplanten Gebiets in voraussichtliche Wärmeversorgungsgebiete und Zuordnung der Eignungsstufen für die Wärmeversorgungsarten, jeweils für das Zieljahr entsprechend WPG Anlage 2 IV und V (sowie  WPG  § 28  Abs. 2)</documentation>
      </annotation>
   </element>
   <complexType name="WP_WaermeversorgungsgebietZieljahrType">
      <complexContent>
         <extension base="xwp:WP_WaermversorgungsgebietType">
            <sequence>
               <element minOccurs="0"
                        name="eignungDezentraleVersorgung"
                        type="xwp:WP_EignungsstufeType">
                  <annotation>
                     <documentation>Eignungsstufen für die dezentrale Versorgung&#xD;
Konformitätsbedingung: nur optional in der kleinen Wärmeplanung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eignungWaermenetz"
                        type="xwp:WP_EignungsstufeType">
                  <annotation>
                     <documentation>Eignungsstufen für Versorgung über ein Wärmenetz&#xD;
Konformitätsbedingung: nur optional in der kleinen Wärmeplanung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eignungWasserstoffnetz"
                        type="xwp:WP_EignungsstufeType">
                  <annotation>
                     <documentation>Eignungsstufen für Versorgung über ein Wasserstoffnetz&#xD;
Konformitätsbedingung: nur optional in der kleinen Wärmeplanung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eignungGruenesMethan"
                        type="xwp:WP_EignungsstufeType">
                  <annotation>
                     <documentation>Eignungsstufen für Versorgung mit grünem Methan</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element abstract="true"
            name="WP_Waermversorgungsgebiet"
            substitutionGroup="xwp:WP_BeplantesTeilgebiet"
            type="xwp:WP_WaermversorgungsgebietType">
      <annotation>
         <documentation>Abstrakte Oberklasse für Wärmeversorgungsgebiete. Die räumliche Einteilung in konkrete Wärmeversorgungsgebiete für die Betrachtungszeitpunkte ist variabel.</documentation>
      </annotation>
   </element>
   <complexType abstract="true" name="WP_WaermversorgungsgebietType">
      <complexContent>
         <extension base="xwp:WP_BeplantesTeilgebietType">
            <sequence>
               <element name="versorgungsart" type="xwp:WP_WaermeversorgungsgebietTypType">
                  <annotation>
                     <documentation>Geplante Art der Wärmeversorgung für das betrachtete Gebiet</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="waermeMenge" type="gml:MeasureType">
                  <annotation>
                     <documentation>Jährlicher Wärmebedarf aller Objekte, die dem Wärmeversorgungsgebiet zugeordnet sind</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="eeNachEnergietraeger"
                        type="xwp:WP_EndenergieEnergietraegerPropertyType">
                  <annotation>
                     <documentation>Jährlicher Endenergiebedarf für Wärme je Energieträger</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="sanierungsrate" type="gml:MeasureType">
                  <annotation>
                     <documentation>Jährliche Sanierungsrate der Gebäude</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <simpleType name="WP_ZeitpunktArtType">
      <annotation>
         <documentation>Bilanzart</documentation>
      </annotation>
      <restriction base="string">
         <enumeration value="1000">
            <annotation>
               <documentation>Basisjahr der Bestandsanalyse</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2000">
            <annotation>
               <documentation>Stützjahr des WPG</documentation>
            </annotation>
         </enumeration>
         <enumeration value="3000">
            <annotation>
               <documentation>Zieljahr</documentation>
            </annotation>
         </enumeration>
         <enumeration value="4000">
            <annotation>
               <documentation>frei wählbares Jahr, passend zu Ausbaumaßnahmen der Wärmeversorgung</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
</schema>
