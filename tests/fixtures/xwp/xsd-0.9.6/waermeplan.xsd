         <extension base="xwp:WP_FlaechenobjektType">
            <sequence>
               <element minOccurs="0" name="waermebedarfsreduktion" type="gml:MeasureType">
                  <annotation>
                     <documentation>Absolute Reduktion des Wärmebedarfs (Erzeugernutzwärme) im Betrachtungsgebiet zwischen Basisjahr und Zieljahr, resultierend aus Effizienzmaßnahmen an Gebäudehülle und Anlagentechnik/Verteilung), unabhängig von einem Wechsel des Wärmeerzeugers.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="waermebedarfsreduktionRelativ"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Relative Reduktion des Wärmebedarfs (Erzeugernutzwärme) im Betrachtungsgebiet zwischen Basisjahr und Zieljahr, resultierend aus Effizienzmaßnahmen an Gebäudehülle und Anlagentechnik/Verteilung), unabhängig von einem Wechsel des Wärmeerzeugers.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="neWaermebedarfsreduktion"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Absolute Reduktion der Nutzenergie für Raumwärme und Trinkwarmwasser im Betrachtungsgebiet zwischen Basisjahr und Zieljahr, resultierend aus energetischer Sanierung der Gebäudehülle, unabhängig von Anlagentechnik und Wärmeerzeuger.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="neWaermebedarfsreduktionRelativ"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Relative Reduktion des Nutzenergie für Raumwärme und Trinkwarmwasser im Betrachtungsgebiet zwischen Basisjahr und Zieljahr, resultierend aus energetischer Sanierung der Gebäudehülle, unabhängig von Anlagentechnik und Wärmeerzeuger.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eeWaermebedarfsreduktion"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Absolute Reduktion es Endenergiebedarfs im Betrachtungsgebiet zwischen Basisjahr und Zieljahr. Enthält zusätzlich zur Wärmebedarfsreduktion den Effekt aus einem Wechsel des Wärmeerzeugers.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eeWaermebedarfsreduktionRelativ"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Absolute Reduktion es Endenergiebedarfs im Betrachtungsgebiet zwischen Basisjahr und Zieljahr. Enthält zusätzlich zur Wärmebedarfsreduktion den Effekt aus einem Wechsel des Wärmeerzeugers.</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
