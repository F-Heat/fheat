            type="xwp:WP_EnergieeinsparungGebaeudeType">
      <annotation>
         <documentation>Raumbezogenes Potenzial zur Energieeinsparung durch Wärmebedarfsreduktion in Gebäuden entsprechend WPG Anlage 2 II.</documentation>
      </annotation>
   </element>
