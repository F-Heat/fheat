               <element minOccurs="0" name="aufschrift" type="string">
                  <annotation>
                     <documentation>Spezifischer Text zur Beschriftung von Planinhalten</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="refTextInhalt" type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz eines raumbezogenen Fachobjektes auf einen textuell formulierten Planinhalt</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_TextAbschnitt</targetElement>
                     </appinfo>
                  </annotation>
               </element>
               <element minOccurs="0" name="refMassnahme" type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz eines raumbezogenen Fachobjektes auf eine Maßnahme zur Umsetzung des Wärmeplans</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Massnahme</targetElement>
                     </appinfo>
                  </annotation>
               </element>
               <element name="gehoertZuBereich" type="gml:ReferenceType">
                  <annotation>
                     <documentation>Verweis auf den Bereich, zu dem der Planinhalt gehört</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Bereich</targetElement>
                     </appinfo>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_Plan"
            substitutionGroup="gml:AbstractFeature"
            type="xwp:WP_PlanType">
      <annotation>
         <documentation>Die Klasse modelliert einen Wärmeplan gemäß § 23 Wärmeplanungsgesetz (WPG). Sie umfasst die in der Anlage 2 aufgeführte kartografische Darstellung der Bestands- und Potenzialanalyse, die Einteilung in Wärmeversorgungsgebiete, die Indikatoren des Zielszenarios, die Darstellung der Wärmeversorgungsarten für das Zieljahr sowie Maßnahmen der Umsetzungsstrategie. Die textlichen und grafischen Erläuterungen der Eignungsprüfung, Bestandsanalyse, des Zielszenarios und der Umsetzungsstrategie können dem Wärmeplan als externe Referenzen beigefügt werden.</documentation>
      </annotation>
   </element>
   <complexType name="WP_PlanType">
      <complexContent>
         <extension base="gml:AbstractFeatureType">
            <sequence>
               <element name="name" type="string">
                  <annotation>
                     <documentation>Name des Wärmeplans. Das Attribut name setzt sich aus den Attributen nameBasis, nummer und fassungsbezeichnung zusammen.&#xD;
(kann für Kodierung von Links in GML, HTML, JSON verwendet werden)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nameBasis" type="string">
                  <annotation>
                     <documentation>Unveränderlicher Basisname des Plans</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="fassungsbezeichnung" type="string">
                  <annotation>
                     <documentation>Bezeichnung einer fortlaufenden Fassung des Plans</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Nummer des Plans</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="internalId" type="string">
                  <annotation>
                     <documentation>Interner Identifikator des Plans</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="beschreibung" type="string">
                  <annotation>
                     <documentation>Kommentierende Beschreibung des Plans</documentation>
                  </annotation>
               </element>
               <element name="planungsverantwortlicheStelle" type="xwp:WP_GemeindePropertyType">
                  <annotation>
                     <documentation>Planungsverantwortliche Stelle bzw. planungsverantwortliche Stelle, die in der interkommunalen Kooperation  den Wärmeplan hauptverantwortlich erstellt</documentation>
                  </annotation>
               </element>
               <element name="verfahrensart" type="xwp:WP_VerfahrenArtType">
                  <annotation>
                     <documentation>Verfahrensart</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="istPlanungGemeindeverband" type="boolean">
                  <annotation>
                     <documentation>Wärmeplanung wurde in landesrechtlich verankertem Gemeindeverband durchgeführt = true. Default = false.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="istPlanungKonvoi" type="boolean">
                  <annotation>
                     <documentation>Wärmeplanung wurde in freiwilliger Kooperation benachbarter Gemeinden (im Konvoi) durchgeführt = true. Default = false.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="istGemeinsamerWaermeplan" type="boolean">
                  <annotation>
                     <documentation>Dieser Wärmeplan ist ein gemeinsamer Wärmeplan von mindestens zwei planungsverantwortlichen Stellen = true. Default = false.</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="beteiligteGemeinden"
                        type="xwp:WP_GemeindePropertyType">
                  <annotation>
                     <documentation>Weitere beteiligte Gemeinden bei einer interkommunalen Zusammenarbeit in der Wärmeplanung und/oder bei der gemeinsamen Erstellung dieses Wärmeplans</documentation>
                  </annotation>
               </element>
               <element name="gesetzlicheGrundlage" type="xwp:WP_GesetzlicheGrundlageType">
                  <annotation>
                     <documentation>Gesetzliche Grundlage des Wärmeplans</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="foerderkennzeichen" type="string">
                  <annotation>
                     <documentation>Förderkennzeichen bei einer Förderung durch die Kommunalrichtlinie</documentation>
                  </annotation>
               </element>
               <element name="zieljahr" type="string">
                  <annotation>
                     <documentation>Das Jahr, in dem spätestens die Umstellung auf eine treibhausgasneutrale Wärmeversorgung abgeschlossen sein soll.</documentation>
                  </annotation>
               </element>
               <element name="basisJahrDatenerfassung" type="string">
                  <annotation>
                     <documentation>Basisjahr der Datenerfassung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="hatEnergieeinsparpotenzialgebiete"
                        type="boolean">
                  <annotation>
                     <documentation>Es sind Teilgebiete mit erhöhtem Energieeinsparpotenzial (§ 18 Abs. 5 WPG) ausgewiesen  = true. Default = false.&#xD;
Siehe:  WP_Energieeinsparpotenzialgebiet</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="hatKlimaneutraleWaermeversGeb" type="boolean">
                  <annotation>
                     <documentation>Es sind Teilgebiete ausgewiesen, in denen die Wärmeversorgung (nahezu) vollständig auf erneuerbaren Energien, unvermeidbarer Abwärme oder einer Kombination hieraus beruht (§ 14 Abs. 6 WPG) = true. Default = false.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="istFortschreibung" type="boolean">
                  <annotation>
                     <documentation>Der Plan ist eine Forschreibung (§ 25 WPG) = true. Default = false.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="ersetztPlan"
                        type="xwp:WP_VerbundenerPlanPropertyType">
                  <annotation>
                     <documentation>Verweis auf vorherigen Wärmeplan, der durch den vorliegenden Plan ersetzt wird.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="aufstellungsbeschlussDatum" type="date">
                  <annotation>
                     <documentation>Beschluss oder die Entscheidung der planungsverantwortlichen Stelle über die Durchführung der Wärmeplanung gemäß § 13 WPG</documentation>
                  </annotation>
               </element>
               <element name="beschlussDatum" type="date">
                  <annotation>
                     <documentation>WPG § 13: Der Wärmeplan wird durch das nach Maßgabe des Landesrechts zuständige Gremium oder die zuständige Stelle beschlossen</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="technHerstellDatum" type="date">
                  <annotation>
                     <documentation>Datum der letzten technischen oder fachlichen Änderung an diesem Plan im datenhaltenden System</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="technischePlanerstellung"
                        type="string">
                  <annotation>
                     <documentation>Bezeichnung der Institution oder Firma, die den Plan technisch erstellt hat.</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="externeReferenz"
                        type="xwp:WP_ExterneReferenzPropertyType">
                  <annotation>
                     <documentation>Referenz auf eine digital verfügbare Ressource</documentation>
                  </annotation>
               </element>
               <element name="raeumlicherGeltungsbereich" type="gml:MultiSurfacePropertyType">
                  <annotation>
                     <documentation>Grenze des räumlichen Geltungsbereiches des Plans</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="energiebilanz"
                        type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz auf Energiebilanzen</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Energiebilanz</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:gehoertZuPlan</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="infrastruktur"
                        type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz auf aggregierte Daten der Gebäude und Netzinfrastruktur</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_WaermeinfrastrukturAggregiert</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:gehoertZuPlan</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="potenzialanalyse"
                        type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz auf Daten der Potenzialanalyse</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_PotenzialanalyseAggregiert</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:gehoertZuPlan</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="massnahme"
                        type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz auf eine Maßnahme zur Umsetzung des Wärmeplans</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Massnahme</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:gehoertZuPlan</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="text"
                        type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz des Plans auf einen Text</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_TextAbschnitt</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:gehoertZuPlan</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="bereich"
                        type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz des Plans auf einen Bereich</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Bereich</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:gehoertZuPlan</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_PotenzialWaermenutzung"
            substitutionGroup="xwp:WP_Geometrieobjekt"
            type="xwp:WP_PotenzialWaermenutzungType">
      <annotation>
         <documentation>Raumbezogenes Potenzial zur Nutzung/Erzeugung von Wärme aus erneuerbaren Energien und zur Nutzung von unvermeidbarer Abwärme entsprechend WPG Anlage 2 II.</documentation>
      </annotation>
   </element>
   <complexType name="WP_PotenzialWaermenutzungType">
      <complexContent>
         <extension base="xwp:WP_GeometrieobjektType">
            <sequence>
               <element minOccurs="0" name="verzeichnisID" type="string">
                  <annotation>
                     <documentation>Vollständige ID eines landesspezifischen Verzeichnis, z.B. "See-ID:  6884 (AWGN)"</documentation>
                  </annotation>
               </element>
               <element name="energietraeger" type="xwp:WP_EnergietraegerType">
                  <annotation>
                     <documentation>Potenzieller Energieträger</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="waermepotenzial" type="gml:MeasureType">
                  <annotation>
                     <documentation>Jährliche potenziell nutzbare/erzeugbare Wärmemenge (Erzeugernutzwärme)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="durchfluss" type="gml:MeasureType">
                  <annotation>
                     <documentation>Durchfluss eines Fließgewässers</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="volumen" type="gml:MeasureType">
                  <annotation>
                     <documentation>Volumen eines stehenden Gewässers</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="deltaT" type="gml:MeasureType">
                  <annotation>
                     <documentation>ΔT: Bei der Berechnung angenommene Temperaturauskühlung eines Gewässers durch Wärmeentzug</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="hinweis" type="string">
                  <annotation>
                     <documentation>Textlicher Hinweis, Erläuterung</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_PotenzialWaermespeicherung"
            substitutionGroup="xwp:WP_Geometrieobjekt"
            type="xwp:WP_PotenzialWaermespeicherungType">
      <annotation>
         <documentation>Raumbezogenes Potenzial zur Wärmespeicherung entsprechend WPG Anlage 2 II.</documentation>
      </annotation>
   </element>
   <complexType name="WP_PotenzialWaermespeicherungType">
      <complexContent>
         <extension base="xwp:WP_GeometrieobjektType">
            <sequence>
               <element name="potenzielleKapazitaet" type="gml:MeasureType">
                  <annotation>
                     <documentation>Potenzielle maximal speicherbare Wärmemenge (Erzeugernutzwärme)</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="WP_PotenzialanalyseAggregiert"
            substitutionGroup="gml:AbstractFeature"
            type="xwp:WP_PotenzialanalyseAggregiertType">
      <annotation>
         <documentation>Zusammenfassende aggregierte Daten der Potenzialanalyse für das Planungsgebiet entsprechend WPG Anlage 2 II</documentation>
      </annotation>
   </element>
   <complexType name="WP_PotenzialanalyseAggregiertType">
      <complexContent>
         <extension base="gml:AbstractFeatureType">
            <sequence>
               <element name="name" type="string">
                  <annotation>
                     <documentation>Name der Tabelle (kann für Kodierung von Links in GML, HTML, JSON verwendet werden)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="regionalSchluessel" type="string">
                  <annotation>
                     <documentation>Amtlicher Regionalschlüssel der betreffenden Gemeinde (Attribut istGemeinsamerWaermeplan = true)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="waermebedarfsreduktionGebaeude"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Potenziale zur Energieeinsparung durch Wärmebedarfsreduktion von Gebäuden (Erzeugernutzwärme) nach Anlage 2 Abschnitt II und § 16 Abs. 2 WPG (Zieljahr gegenüber Basisjahr).</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="neWaermebedarfsreduktionGebaeude"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Potenziale zur Energieeinsparung durch Wärmebedarfsreduktion von Gebäuden (Nutzenergie) nach Anlage 2 Abschnitt II und § 16 Abs. 2 WPG (Zieljahr gegenüber Basisjahr).</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eeWaermebedarfsreduktionGebaeude"
                        type="gml:MeasureType">
                  <annotation>
                     <documentation>Potenziale zur Energieeinsparung durch Wärmebedarfsreduktion von Gebäuden (Endenergie) nach Anlage 2 Abschnitt II und § 16 Abs. 2 WPG (Zieljahr gegenüber Basisjahr).</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        name="erneuerbareEnergienAbwaerme"
                        type="xwp:WP_EndenergieEnergietraegerPropertyType">
                  <annotation>
                     <documentation>Potenziale erneuerbarer Energien (EE) und unvermeidbarer Abwärme zur Wärmeversorgung nach Energieträgern nach Anlage 2 Abschnitt II und § 16 Abs. 1 WPG&#xD;
Konformitätsbedingungen: zulässige Enumerationswerte 12003, 2000 bis 32004, 40001, 4100, ab 5000</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="technischeSynergieeffekte" type="boolean">
                  <annotation>
                     <documentation>Es wurden technische Synergieeffekte identfiziet = true. &#xD;
Technische Synergieeffekte entstehen durch die gemeinsame Nutzung oder Integration von Infrastrukturen und Technologien, die Effizienzsteigerungen und Kosteneinsparungen bei der Wärmeversorgung ermöglichen. Dazu zählen bspw. die Nutzung lokaler Erneuerbarer Energiequellen zur Wärmeerzeugung oder die Nutzung der Vorteile der Sektorkopplung. (Anforderung gilt für Gemeindegebiet mit mehr als 45.000 Einwohnern, WPG § 21)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="organisatorischeSynergieeffekte" type="boolean">
                  <annotation>
                     <documentation>Es wurden organisatorische Synergieeffekte identfiziet = true. &#xD;
Organisatorische Synergieeffekte beziehen sich auf die Zusammenarbeit und Koordination zwischen verschiedenen Akteuren und Institutionen, die zu einer besseren Planung, Steuerung und Umsetzung von Wärmeprojekten führt. Beispiele können die Bündelung von Ressourcen oder die gemeinsame Durchführung der Bürgerbeteiligung und -information sein. (Anforderung gilt für Gemeindegebiet mit mehr als 45.000 Einwohnern, WPG § 21)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="finanzielleSynergieeffekte" type="boolean">
                  <annotation>
                     <documentation>Es wurden finanzielle Synergieeffekte identfiziet = true. &#xD;
Finanzielle Synergieeffekte resultieren aus der Bündelung von Ressourcen und Investitionen, die zu einer Reduzierung der Kosten und einer verbesserten Wirtschaftlichkeit der Wärmeversorgung führen. Dazu zählen u.a. die gemeinsame Fördermittelakquise oder Förderung und Umsetzung von Energieeffizienzmaßnahmen in privaten und gewerblichen Gebäuden. (Anforderung gilt für Gemeindegebiet mit mehr als 45.000 Einwohnern, WPG § 21)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="beruecksichtigungEEGemeinschaften"
                        type="boolean">
                  <annotation>
                     <documentation>Es wurden Erneuerbare-Energie-Gemeinschaften berücksichtigt  = true. &#xD;
Gemäß WPG §21 (2) soll eine Bewertung der Rolle von Erneuerbare-Energie-Gemeinschaften oder anderer von den Verbrauchern ausgehender Initiativen enthalten, die aktiv zur Umsetzung lokaler Projekte im Bereich Wärmeversorgung beitragen können (Anforderung gilt für Gemeindegebiet mit mehr als 45.000 Einwohnern)</documentation>
                  </annotation>
               </element>
               <element name="gehoertZuPlan" type="gml:ReferenceType">
                  <annotation>
                     <documentation>Relation der Potenzialanalyse auf den zugehörigen Plan</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xwp:WP_Plan</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xwp:potenzialanalyse</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <simpleType name="WP_SchutzgebietTypType">
      <annotation>
         <documentation>Liste von Schutzgebietstypen mit zentraler gesetzlicher Grundlage</documentation>
      </annotation>
      <restriction base="string">
