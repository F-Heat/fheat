         <documentation>Baublockbezogene Informationen zum Wärmeverbrauch und zur dezentralen Wärmeerzeugung entsprechend WPG Anlage  2 I.2.1, I.2.3 und 2 I.2.4 sowie darüber hinausgehende optionale Informationen</documentation>
      </annotation>
   </element>
   <complexType name="WP_EnergieBaublockType">
      <complexContent>
         <extension base="xwp:WP_BaublockType">
            <sequence>
               <element minOccurs="0" name="waermeMenge" type="gml:MeasureType">
                  <annotation>
                     <documentation>Jährlicher Wärmebedarf oder Wärmeverbrauch  aller Objekte, die einem Baublock zugeordnet sind (Erzeugernutzwärme)</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="waermeDichte" type="gml:MeasureType">
                  <annotation>
                     <documentation>Wärmeverbrauch oder Wärmebedarf pro Hektar und Jahr (Erzeugernutzwärme)</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="eeNachEnergietraeger"
                        type="xwp:WP_EndenergieEnergietraegerPropertyType">
                  <annotation>
                     <documentation>Jährlicher Endenergieverbrauch oder -bedarf für Wärme je Energieträger</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eeNachEnTrEnthaeltLeitungsgebWaerme"
                        type="boolean">
                  <annotation>
                     <documentation>Im Attribut eeNachEnergietraeger ist leitungsgebundene Wärme erfasst = true. Leitungsgebunde Wärme ist auf Baublockebene nicht in Energieträger aufgeschlüsselt = false.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="eeNachVersorgungsart"
                        type="xwp:WP_WaermeversorgungArtPropertyType">
                  <annotation>
                     <documentation>Jährlicher Endenergieverbrauch/-bedarf für Wärme nach Versorgungsart dezentral und leitungsgebunden</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="enthaeltProzesswaermeGHD" type="boolean">
                  <annotation>
                     <documentation>Daten zur Wärme und Endenergie enthalten die Prozesswärme aus dem Gebäudesektor GHD = true.&#xD;
Annahme: Prozesswärme der Industrie wird über WP_Grossverbraucher erfasst.</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="waermeErzeuger"
                        type="xwp:WP_WaermeerzeugerAngabenPropertyType">
