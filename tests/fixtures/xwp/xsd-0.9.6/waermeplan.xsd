               <documentation>Naturschutzgebiet (Bundesnaturschutzgesetz - BNatSchG)</documentation>
            </annotation>
         </enumeration>
         <enumeration value="5200">
            <annotation>
               <documentation>Landschaftsschutzgebiet (Bundesnaturschutzgesetz - BNatSchG)</documentation>
            </annotation>
         </enumeration>
         <enumeration value="5300">
            <annotation>
               <documentation>Nationalpark (Bundesnaturschutzgesetz - BNatSchG)</documentation>
            </annotation>
