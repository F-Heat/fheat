               <documentation>Sonstiges Schutzgebiet</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <simpleType name="WP_StatusType">
      <annotation>
         <documentation>Statusformen für Infrastruktur und Großverbraucher</documentation>
      </annotation>
      <restriction base="string">
         <enumeration value="1000">
            <annotation>
               <documentation>Wärmenetz in Betrieb oder bestehender Großverbraucher</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2000">
            <annotation>
               <documentation>in Planung befindliches oder genehmigtes Wärmenetz</documentation>
            </annotation>
         </enumeration>
         <enumeration value="3000">
            <annotation>
               <documentation>potenzieller Großverbraucher oder potenzielles Wärmenetz</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <simpleType name="WP_StuetzjahrType">
      <annotation>
         <documentation>Stützjahre der Wärmeplanung</documentation>
      </annotation>
      <restriction base="string">
         <enumeration value="1000">
            <annotation>
               <documentation>2030</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2000">
            <annotation>
               <documentation>2035</documentation>
            </annotation>
         </enumeration>
         <enumeration value="3000">
            <annotation>
               <documentation>2040</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <element name="WP_TextAbschnitt"
            substitutionGroup="gml:AbstractFeature"
            type="xwp:WP_TextAbschnittType">
      <annotation>
         <documentation>Ein Abschnitt der textlich formulierten Inhalte  des Plans</documentation>
